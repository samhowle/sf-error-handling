		"lint": "eslint **/lwc/**/*.js",
		"prettier": "prettier --write \"**/*.{cls,trigger,js,json,md,xml}\""
	},
	"devDependencies": {
		"@lwc/eslint-plugin-lwc": "^1.8.0",
		"@salesforce/eslint-config-lwc": "^3.5.0",
		"@salesforce/sfdx-lwc-jest": "^5.0.0",
		"eslint": "^8.57.0",
		"prettier": "^3.3.0",
		"prettier-plugin-apex": "^2.1.0"
	}
