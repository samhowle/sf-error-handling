    <textTemplates>
        <description>Rich-text block used when the handler action itself fails.</description>
        <name>FallbackDisplayMessage</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;strong&gt;{!$Label.FlowFaultHeading}&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!FallbackUserMessage}&lt;/p&gt;&lt;p&gt;&lt;em&gt;{!$Label.FlowFaultTechnicalDetailsLabel}&lt;/em&gt;&lt;br/&gt;{!faultMessage}&lt;/p&gt;</text>
    </textTemplates>
