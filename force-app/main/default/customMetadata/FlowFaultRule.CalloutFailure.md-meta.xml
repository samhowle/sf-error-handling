<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Callout failure</label>
    <protected>false</protected>
    <values>
        <field>AdminGuidance__c</field>
        <value xsi:type="xsd:string">An external callout failed: {detail}. Check the Named Credential or Remote Site Setting, endpoint availability, and the integration user's credentials.</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:type="xsd:string">Apex</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>IsRetryable__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>IsUserCorrectable__c</field>
        <value xsi:type="xsd:boolean">false</value>
    </values>
    <values>
        <field>MatchType__c</field>
        <value xsi:type="xsd:string">Regex</value>
    </values>
    <values>
        <field>Pattern__c</field>
        <value xsi:type="xsd:string">(?i)System\.CalloutException|Read timed out|Unable to tunnel|Unauthorized endpoint|IO Exception</value>
    </values>
    <values>
        <field>Priority__c</field>
        <value xsi:type="xsd:double">7</value>
    </values>
    <values>
        <field>Severity__c</field>
        <value xsi:type="xsd:string">WARN</value>
    </values>
    <values>
        <field>UserMessageTemplate__c</field>
        <value xsi:type="xsd:string">A connected system did not respond. Your changes were not saved. Please try again in a few minutes.</value>
    </values>
</CustomMetadata>
