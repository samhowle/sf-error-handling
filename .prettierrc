{
	"useTabs": true,
	"printWidth": 120,
	"singleQuote": true,
	"trailingComma": "none",
	"overrides": [
		{ "files": "*.{cls,trigger}", "options": { "parser": "apex" } },
		{ "files": "*.{cmp,page,component}", "options": { "parser": "html" } },
		{ "files": "*.xml", "options": { "useTabs": false, "tabWidth": 4 } }
	]
}
