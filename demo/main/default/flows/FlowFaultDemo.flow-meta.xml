<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Demo action that throws the requested Apex exception. Its fault connector shows the Apex fault path.</description>
        <name>Throw_Exception</name>
        <label>Throw Exception</label>
        <locationX>578</locationX>
        <locationY>350</locationY>
        <actionName>FlowFaultDemoAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handle_Fault_Apex</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>kinds</name>
            <value>
                <elementReference>Scenario</elementReference>
            </value>
        </inputParameters>
        <nameSegment>FlowFaultDemoAction</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>63.0</apiVersion>
    <choices>
        <name>Scenario_Custom</name>
        <choiceText>Apex action throws a custom exception</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Custom</stringValue>
        </value>
    </choices>
    <choices>
        <name>Scenario_Dml</name>
        <choiceText>Apex action fails on DML (REQUIRED_FIELD_MISSING nested in System.DmlException)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Dml</stringValue>
        </value>
    </choices>
    <choices>
        <name>Scenario_NullPointer</name>
        <choiceText>Apex action hits a null pointer</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>NullPointer</stringValue>
        </value>
    </choices>
    <choices>
        <name>Scenario_RequiredField</name>
        <choiceText>Create Records with no last name (REQUIRED_FIELD_MISSING)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>RequiredField</stringValue>
        </value>
    </choices>
    <choices>
        <name>Scenario_Success</name>
        <choiceText>Create a valid Contact (success path; add a validation rule on Contact to see a validation fault)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>None</stringValue>
        </value>
    </choices>
    <decisions>
        <description>Retry returns to the scenario screen; Cancel ends the flow.</description>
        <name>After_Fault</name>
        <label>What did the user choose?</label>
        <locationX>314</locationX>
        <locationY>674</locationY>
        <defaultConnectorLabel>Cancel</defaultConnectorLabel>
        <rules>
            <name>Chose_Retry</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>selectedAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Retry</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Choose_Scenario</targetReference>
            </connector>
            <label>Retry</label>
        </rules>
    </decisions>
    <decisions>
        <name>Route</name>
        <label>Route scenario</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Throw_Exception</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Apex scenario</defaultConnectorLabel>
        <rules>
            <name>Is_Required_Field</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Scenario</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RequiredField</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Contact_Missing_Name</targetReference>
            </connector>
            <label>Required field missing</label>
        </rules>
        <rules>
            <name>Is_Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Scenario</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>None</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Contact</targetReference>
            </connector>
            <label>Success</label>
        </rules>
    </decisions>
    <description>Demo of the Flow fault handling pattern. Each Create Records and Apex action element has a fault connector to a FlowFaultHandlerScreen subflow element that names the faulting element; all three feed one decision that loops back on Retry. Deploy only to sandboxes and scratch orgs.</description>
    <environments>Default</environments>
    <formulas>
        <description>Troubleshooting context logged with the fault. Never shown to the user.</description>
        <name>ContextDetails</name>
        <dataType>String</dataType>
        <expression>"Scenario=" &amp; {!Scenario} &amp; "; LastName=" &amp; {!LastName}</expression>
    </formulas>
    <interviewLabel>FlowFaultDemo {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Flow Fault Demo</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <description>Success path. Fails only if the org has a validation rule or trigger on Contact that rejects it, which is a good way to see a real validation fault.</description>
        <name>Create_Contact</name>
        <label>Create Contact</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handle_Fault_Create</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>FirstName</field>
            <value>
                <stringValue>Flow Fault Demo</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <elementReference>LastName</elementReference>
            </value>
        </inputAssignments>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>Always fails with REQUIRED_FIELD_MISSING because LastName is not set.</description>
        <name>Create_Contact_Missing_Name</name>
        <label>Create Contact (missing last name)</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handle_Fault_Missing_Name</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>FirstName</field>
            <value>
                <stringValue>Flow Fault Demo</stringValue>
            </value>
        </inputAssignments>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <screens>
        <name>Choose_Scenario</name>
        <label>Flow Fault Demo</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Route</targetReference>
        </connector>
        <fields>
            <name>Intro</name>
            <fieldText>&lt;p&gt;Pick a scenario. Each one takes a fault connector into the reusable &lt;strong&gt;Flow Fault Handler (Screen)&lt;/strong&gt; subflow, which classifies and logs the fault, rolls back the transaction and shows the standard error panel.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Scenario</name>
            <choiceReferences>Scenario_RequiredField</choiceReferences>
            <choiceReferences>Scenario_Custom</choiceReferences>
            <choiceReferences>Scenario_NullPointer</choiceReferences>
            <choiceReferences>Scenario_Dml</choiceReferences>
            <choiceReferences>Scenario_Success</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Scenario</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>LastName</name>
            <dataType>String</dataType>
            <defaultValue>
                <stringValue>Demo</stringValue>
            </defaultValue>
            <fieldText>Last name for the success scenario</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Success_Screen</name>
        <label>Success</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Success_Text</name>
            <fieldText>&lt;p&gt;No fault this time. Contact ID: {!Create_Contact}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Choose_Scenario</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <description>Fault path for the Apex action.</description>
        <name>Handle_Fault_Apex</name>
        <label>Handle Fault (Apex)</label>
        <locationX>578</locationX>
        <locationY>458</locationY>
        <connector>
            <targetReference>After_Fault</targetReference>
        </connector>
        <flowName>FlowFaultHandlerScreen</flowName>
        <inputAssignments>
            <name>contextDetails</name>
            <value>
                <elementReference>ContextDetails</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>elementApiName</name>
            <value>
                <stringValue>Throw_Exception</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>flowApiName</name>
            <value>
                <stringValue>FlowFaultDemo</stringValue>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>selectedAction</assignToReference>
            <name>selectedAction</name>
        </outputAssignments>
    </subflows>
    <subflows>
        <description>Fault path for the valid Create Contact element.</description>
        <name>Handle_Fault_Create</name>
        <label>Handle Fault (Create Contact)</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <connector>
            <targetReference>After_Fault</targetReference>
        </connector>
        <flowName>FlowFaultHandlerScreen</flowName>
        <inputAssignments>
            <name>contextDetails</name>
            <value>
                <elementReference>ContextDetails</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>elementApiName</name>
            <value>
                <stringValue>Create_Contact</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>flowApiName</name>
            <value>
                <stringValue>FlowFaultDemo</stringValue>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>selectedAction</assignToReference>
            <name>selectedAction</name>
        </outputAssignments>
    </subflows>
    <subflows>
        <description>Fault path for the deliberately broken Create Contact element.</description>
        <name>Handle_Fault_Missing_Name</name>
        <label>Handle Fault (Missing Last Name)</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <connector>
            <targetReference>After_Fault</targetReference>
        </connector>
        <flowName>FlowFaultHandlerScreen</flowName>
        <inputAssignments>
            <name>contextDetails</name>
            <value>
                <elementReference>ContextDetails</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>elementApiName</name>
            <value>
                <stringValue>Create_Contact_Missing_Name</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>flowApiName</name>
            <value>
                <stringValue>FlowFaultDemo</stringValue>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>selectedAction</assignToReference>
            <name>selectedAction</name>
        </outputAssignments>
    </subflows>
    <variables>
        <description>Retry or Cancel from the fault handler screen.</description>
        <name>selectedAction</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
